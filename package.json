{
  "name": "amb-board",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
