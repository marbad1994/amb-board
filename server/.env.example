HOST=0.0.0.0
PORT=3417

# Optional: enables AI translation of dictated Romanian/Swedish text into English (via xAI's Grok API).
# Without this key, dictated non-English text is saved as-is (untranslated).
X_GROK_API_KEY=

# AI gateway providers (any subset). Order of preference: AI_PROVIDER, then deepseek, then grok.
DEEPSEEK_API_KEY=
AI_PROVIDER=
# Daily AI call budget per workspace (default 100)
AI_DAILY_LIMIT=

# Email notifications (Zoho Mail, EU data centre). Leave SMTP_PASS empty to keep email off.
# SMTP_USER is the full mailbox address; if the account uses two-factor login, create an application-specific password in Zoho.
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@makketing.com
SMTP_PASS=
SMTP_FROM=AMB Board <admin@makketing.com>
# Public address used for the links inside emails
APP_URL=https://amb.makketing.com

# Web search for the assistant (optional). Pick ONE provider; without it the assistant says search is not set up.
# SEARCH_PROVIDER=brave|tavily|searxng is chosen automatically from whichever key/URL below is set.
BRAVE_API_KEY=
TAVILY_API_KEY=
# A self-hosted SearXNG with the json format enabled (no key, queries stay on your server)
SEARXNG_URL=
# Searches and page reads allowed per person per day
SEARCH_DAILY_LIMIT=50
